{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokscale Dashboard",
  "version": "4.8.1",
  "identifier": "ai.tokscale.frontend",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tokscale Dashboard",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
