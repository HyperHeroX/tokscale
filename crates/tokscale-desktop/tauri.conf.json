{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokscale",
  "version": "4.8.1",
  "identifier": "ai.tokscale.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tokscale",
        "width": 460,
        "height": 320,
        "minWidth": 460,
        "minHeight": 220,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
